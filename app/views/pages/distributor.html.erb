<div class="container mt-5">

  <div class="d-flex justify-content-between align-items-center mb-5">
<div>

  <h1 class="fw-bold">
    Dashboard
  </h1>

  <p class="text-muted">
    Welcome back, <%= current_user.email %>
  </p>

</div>

<%= link_to "Create New Order",
    new_order_path,
    class: "btn primary-btn" %>


  </div>

  <div class="row">


<div class="col-lg-6">

  <div class="page-card mb-4">

    <h4 class="mb-4">
      Available Products
    </h4>

    <% if @skus.any? %>

      <table class="table table-hover">

        <thead>

          <tr>

            <th>Product</th>
            <th>Price Per Unit</th>

          </tr>

        </thead>

        <tbody>

          <% @skus.each do |sku| %>

            <tr>

              <td>
                <%= sku.product.name %>
              </td>

              <td>
                <%= number_with_delimiter(sku.price_per_unit) %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    <% else %>

      <div class="alert alert-warning mb-0">

        No products have been configured for your account yet.

      </div>

    <% end %>

  </div>

</div>

<div class="col-lg-6">

  <div class="page-card">

    <h4 class="mb-4">
      Recent Orders
    </h4>

    <% if @recent_orders.any? %>

      <table class="table table-hover">

        <thead>

          <tr>

            <th>Order</th>
            <th>Status</th>
            <th>Delivery Date</th>

          </tr>

        </thead>

        <tbody>

          <% @recent_orders.each do |order| %>

            <tr>

              <td>

                <%= link_to order.order_number,
                    order_path(order) %>

              </td>

              <td>

                <%= order.status.capitalize %>

              </td>

              <td>

                <%= order.required_delivery_date %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    <% else %>

      <div class="alert alert-secondary mb-0">

        No orders have been placed yet.

      </div>

    <% end %>

  </div>

</div>

  </div>

</div>

