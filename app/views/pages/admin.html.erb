<div class="container-fluid">

  <div class="row">

    <div class="col-md-2 sidebar p-4">

      <h3 class="fw-bold mb-5"
          style="color:#FF991C;">
        Union Swiss
      </h3>

      <div class="d-grid gap-3">

        <%= link_to "Dashboard",
            admin_path,
            class: "btn btn-light text-start" %>

        <%= link_to "Products",
            products_path,
            class: "btn btn-light text-start" %>

        <%= link_to "Orders",
            orders_path,
            class: "btn btn-light text-start" %>

        <%= link_to "SKUs",
            skus_path,
            class: "btn btn-light text-start" %>

        <%= link_to "Distributors",
            distributors_path,
            class: "btn btn-light text-start" %>
        

      </div>

      <div class="mt-5">

        <%= button_to "Log Out",
            destroy_user_session_path,
            method: :delete,
            class: "btn btn-danger w-100" %>

      </div>

    </div>

    <div class="col-md-10 p-5">

  <div class="d-flex justify-content-between align-items-center mb-5">

    <div>
      <h1 class="fw-bold">
        Dashboard
      </h1>

      <p class="text-muted">
        Welcome back, <%= current_user.email %>
      </p>
    </div>

  </div>

  <div class="row g-4">

    <div class="col-lg-3 col-md-6">

      <%= link_to products_path,
          class: "text-decoration-none" do %>

        <div class="card dashboard-card">

          <div class="card-body">

            <h5 class="text-dark">
              Products
            </h5>

            <h1>
              <%= @product_count %>
            </h1>

            <p class="text-muted">
              Manage products
            </p>

          </div>

        </div>

      <% end %>

    </div>

    <div class="col-lg-3 col-md-6">

      <%= link_to orders_path,
          class: "text-decoration-none" do %>

        <div class="card dashboard-card">

          <div class="card-body">

            <h5 class="text-dark">
              Orders
            </h5>

            <h1>
              <%= @order_count %>
            </h1>

            <p class="text-muted">
              View orders
            </p>

          </div>

        </div>

      <% end %>

    </div>

    <div class="col-lg-3 col-md-6">

      <%= link_to skus_path,
          class: "text-decoration-none" do %>

        <div class="card dashboard-card">

          <div class="card-body">

            <h5 class="text-dark">
              SKUs
            </h5>

            <h1>
              <%= @sku_count %>
            </h1>

            <p class="text-muted">
              Manage pricing
            </p>

          </div>

        </div>

      <% end %>

    </div>

    <div class="col-lg-3 col-md-6">

      <%= link_to distributors_path,
          class: "text-decoration-none" do %>

        <div class="card dashboard-card">

          <div class="card-body">

            <h5 class="text-dark">
              Distributors
            </h5>

            <h1>
              <%= @distributor_count %>
            </h1>

            <p class="text-muted">
              Manage distributors
            </p>

          </div>

        </div>

      <% end %>

    </div>

    <div class="row g-4 mt-2">

  <div class="col-lg-3 col-md-6">

    <div class="card dashboard-card">

      <div class="card-body">

        <h5 class="text-dark">
          Pending Orders
        </h5>

        <h1>
          <%= @pending_orders %>
        </h1>

      </div>

    </div>

  </div>

  <div class="col-lg-3 col-md-6">

    <div class="card dashboard-card">

      <div class="card-body">

        <h5 class="text-dark">
          Processing Orders
        </h5>

        <h1>
          <%= @processing_orders %>
        </h1>

      </div>

    </div>

  </div>

  <div class="col-lg-3 col-md-6">

    <div class="card dashboard-card">

      <div class="card-body">

        <h5 class="text-dark">
          Delivered Orders
        </h5>

        <h1>
          <%= @delivered_orders %>
        </h1>

      </div>

    </div>

  </div>

  <div class="col-lg-3 col-md-6">

    <div class="card dashboard-card">

      <div class="card-body">

        <h5 class="text-dark">
          Cancelled Orders
        </h5>

        <h1>
          <%= @cancelled_orders %>
        </h1>

      </div>

    </div>

  </div>

</div>

  <div class="card border-0 shadow-sm mt-5">

  <div class="card-body">

    <h4 class="mb-4">
      Recent Orders
    </h4>

    <table class="table">

      <thead>
        <tr>
          <th>Order</th>
          <th>Status</th>
          <th>Delivery Date</th>
        </tr>
      </thead>

      <tbody>

        <% Order.where.not(status: "draft").last(5).reverse.each do |order| %>

          <tr>

            <td>
              <%= order.order_number %>
            </td>

            <td>
              <%= order.status %>
            </td>

            <td>
              <%= order.required_delivery_date %>
            </td>

          </tr>

       <% end %>

      </tbody>

    </table>

  </div>

</div>
    </div>

  </div>

</div>


