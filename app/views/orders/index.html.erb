<div class="container-fluid p-4">

  <div class="card border-0 shadow-sm" style="border-radius:35px; border:none">


<div class="card-body">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold mb-1">
        Orders
      </h2>

      <p class="text-muted mb-0">
        Manage and track all orders
      </p>
    </div>

    <% unless current_user.admin? %>
      <%= link_to "Start New Order",
          new_order_path,
          class: "btn text-white",
          style: "background-color:#FF991C; border:none; border-radius:35px" %>
    <% end %>

  </div>

  <div class="table-responsive">

    <table class="table table-hover align-middle">

      <thead>

        <tr>
          <th>Order Number</th>

          <% if current_user.admin? %>
            <th>Distributor</th>
          <% end %>

          <th>Status</th>
          <th>Delivery Date</th>
        </tr>

      </thead>

      <tbody>

        <% @orders.each do |order| %>

          <tr
            onclick="window.location='<%= order_path(order) %>'"
            style="cursor:pointer;"
          >

              <td>
                <strong>
                  <%= order.order_number %>
                </strong>
              </td>

            <% if current_user.admin? %>
              <td>
                <%= order.distributor.name %>
              </td>
            <% end %>

            <td>

              <% if current_user.admin? %>

                <%= form_with model: order do |form| %>

                  <%= form.select :status,
                      ["pending", "processing", "delivered", "cancelled"],
                      {},
                      {
                        class: "form-select status-select",
                        onchange: "this.form.requestSubmit()"
                      } %>

                <% end %>

              <% else %>

                <% if order.status == "pending" %>

                  <span class="badge rounded-pill bg-secondary">
                    Pending
                  </span>

                <% elsif order.status == "processing" %>

                  <span class="badge rounded-pill bg-warning text-dark">
                    Processing
                  </span>

                <% elsif order.status == "delivered" %>

                  <span class="badge rounded-pill bg-success">
                    Delivered
                  </span>

                <% elsif order.status == "cancelled" %>

                  <span class="badge rounded-pill bg-danger">
                    Cancelled
                  </span>

                <% end %>

              <% end %>

            </td>

            <td>
              <%= order.required_delivery_date %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

</div>


  </div>

</div>
