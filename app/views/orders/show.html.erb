<h1>Order <%= @order.order_number %></h1>

<p>
    Required Delivery Date:
    <%= @order.required_delivery_date %>
</p>

<% if current_user.admin? %>
    <%=form_with model: @order do |form| %>
        <div>
             <%= form.select :status, ["processing", "delivered", "cancelled"],
                {}, { onchange: "this.form.requestSubmit()" } %>
        </div>
    
    <% end %>
<% end %>
<p>
    Status:
     <%= @order.status %>
</p>

<h2>Items</h2>

<% @order.order_items.each do |item| %>
    <div>
        <p>
            <strong><%= item.sku.product.name %></strong>
        </p>

        <%= button_to "-", 
            decrement_order_order_item_path(@order, item),
            method: :patch %>

        <%= item.pallets %>

        <%= button_to "+", 
            increment_order_order_item_path(@order, item),
            method: :patch %>
        
        <p>
            Total:
            <%= number_with_delimiter(item.total_price) %>
        </p>

        <%= button_to "Delete",
            order_order_item_path(@order, item),
            method: :delete %>
        <hr>

    </div>

<% end %>

<% if current_user.distributor? %>

  <details>
    <summary>Add Item</summary>

    <%= form_with model: [@order, OrderItem.new] do |form| %>

      <div>
        <%= form.label :sku_id, "Product" %>

        <%= form.collection_select(
          :sku_id,
          current_user.distributor.skus,
          :id,
          :display_name
        ) %>
      </div>

      <%= form.hidden_field :pallets, value: 1 %>

      <div>
        <%= form.submit "Add Product" %>
      </div>

    <% end %>

  </details>

<% end %>


<h3>
    Order Total:
    <%= number_with_delimiter(@order.total_price) %>
</h3>

<% if current_user.distributor? && @order.status == "draft" %>

    <%= button_to "Submit Order",
        submit_order_path(@order),
        method: :patch %>

<% end %>