<div class="container mt-5">

  <div class="card border-0 shadow-sm">


<div class="card-body">

  <h2 class="mb-4">
    Order <%= @order.order_number %>
  </h2>

  <div class="row mb-4">

    <div class="col-md-4">

      <strong>Status</strong>

      <% if current_user.admin? %>

        <%= form_with model: @order do |form| %>

          <%= form.select :status,
              ["pending", "processing", "delivered", "cancelled"],
              {},
              {
                class: "form-select status-select",
                onchange: "this.form.requestSubmit()"
              } %>

        <% end %>

      <% else %>

        <p>
          <%= @order.status&.capitalize || "Draft" %>
        </p>

      <% end %>

    </div>

    <div class="col-md-4">

      <strong>Distributor</strong>

      <p>
        <%= @order.distributor.name %>
      </p>

    </div>

    <div class="col-md-4">

      <strong>Delivery Date</strong>

      <p>
        <%= @order.required_delivery_date %>
      </p>

    </div>

  </div>

  <h4 class="mb-3">
    Items
  </h4>

  <% if current_user.distributor? && @order.status == "draft" %>

    <div class="card border-0 mb-4">

      <div class="card-body">

        <% if @order.distributor.skus.any? %>
        <%= form_with model: [@order, OrderItem.new] do |form| %>

          <div class="row g-3 align-items-end">

            <div class="col-md-8">

              <%= form.label :sku_id,
                  "Product",
                  class: "form-label" %>

              <%= form.collection_select(
                  :sku_id,
                  @order.distributor.skus,
                  :id,
                  :display_name,
                  {},
                  { class: "form-select" }
              ) %>

            </div>

            <div class="col-md-2">

              <%= form.label :pallets,
                  class: "form-label" %>

              <%= form.number_field :pallets,
                  value: 1,
                  min: 1,
                  class: "form-control" %>

            </div>

            <div class="col-md-2">

              <%= form.submit "Add",
                  class: "btn text-white w-100",
                  style: "background-color:#FF991C;" %>

            </div>

          </div>

        <% end %>
        <% else %>
            <div class="alert alert-warning">
                No products have been configured for your account yet.

                Please contact an administrator.
            </div>
        <% end %>

      </div>

    </div>

  <% end %>

  <table class="table table-hover align-middle">

    <thead>

      <tr>

        <th>Product</th>
        <th>Pallets</th>
        <th>Units</th>
        <th>Total Cost</th>

        <% if current_user.distributor? && @order.status == "draft" %>
          <th>Actions</th>
        <% end %>

      </tr>

    </thead>

    <tbody>

      <% @order.order_items.each do |item| %>

        <tr>

          <td>
            <%= item.sku.product.name %>
          </td>

          <td>

            <% if current_user.distributor? && @order.status == "draft" %>

              <div class="d-flex align-items-center gap-2">

                <%= button_to "-",
                    decrement_order_order_item_path(@order, item),
                    method: :patch,
                    class: "btn btn-sm btn-outline-secondary" %>

                <span>
                  <%= item.pallets %>
                </span>

                <%= button_to "+",
                    increment_order_order_item_path(@order, item),
                    method: :patch,
                    class: "btn btn-sm btn-outline-secondary" %>

              </div>

            <% else %>

              <%= item.pallets %>

            <% end %>

          </td>

          <td>
            <%= number_with_delimiter(item.pallets * 4800) %>
          </td>

          <td>
            R <%= number_with_delimiter(item.total_price) %>
          </td>

          <% if current_user.distributor? && @order.status == "draft" %>

            <td>

              <%= button_to "Delete",
                  order_order_item_path(@order, item),
                  method: :delete,
                  class: "btn btn-sm btn-outline-danger" %>

            </td>

          <% end %>

        </tr>

      <% end %>

    </tbody>

  </table>

  <div class="mt-4">

    <div>

      <h5 class="mb-4">
        Order Summary
      </h5>

      <div class="row">

        <div class="col-md-4">

          <p class="text-muted mb-1">
            Total Products
          </p>

          <h4>
            <%= @order.order_items.count %>
          </h4>

        </div>

        <div class="col-md-4">

          <p class="text-muted mb-1">
            Total Units
          </p>

          <h4>
            <%= number_with_delimiter(@order.total_units) %>
          </h4>

        </div>

        <div class="col-md-4">

          <p class="text-muted mb-1">
            Grand Total
          </p>

          <h4>
            R <%= number_with_delimiter(@order.total_price) %>
          </h4>

        </div>

      </div>

    </div>

  </div>

  <% if current_user.distributor? && @order.status == "draft" %>

    <div class="text-end mt-4">

      <%= button_to "Submit Order",
          submit_order_path(@order),
          method: :patch,
          class: "btn btn-success btn-lg" %>

    </div>

  <% end %>

</div>

  </div>

</div>
