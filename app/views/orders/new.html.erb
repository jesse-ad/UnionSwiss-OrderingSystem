<div class="container mt-5">

  <div class="row justify-content-center">

    <div class="col-md-6">

      <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

          <h2 class="mb-3">
            Start New Order
          </h2>

          <p class="text-muted mb-4">
            Select a required delivery date to begin your order.
          </p>

          <%= form_with model: @order do |form| %>

            <div class="mb-4">

              <%= form.label :required_delivery_date,
                  class: "form-label" %>

              <%= form.date_field :required_delivery_date,
                  class: "form-control" %>

            </div>

            <%= form.submit "Create Draft Order",
                class: "btn text-white w-100",
                style: "background-color:#FF991C;" %>

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>