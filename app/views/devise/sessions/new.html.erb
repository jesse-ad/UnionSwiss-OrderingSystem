
<div class="container-fluid vh-100">

  <div class="row h-100">

    <!-- LEFT SIDE -->
    <div class="col-md-6 d-flex flex-column justify-content-center align-items-center"
         style="background-color:white;">

      <h1 style="color:#FF991C; font-size:4rem; font-weight:bold;">
        Union Swiss
      </h1>

      <h3 class="mt-3">
        Ordering System
      </h3>

      <p class="text-muted">
        Fast, simple distributor ordering.
      </p>

    </div>

    <!-- RIGHT SIDE -->
    <div class="col-md-6 d-flex justify-content-center align-items-center" style="background-color:white">

      <div class="card border-0 shadow-lg"
           style="width:420px; border-radius:30px;">

        <div class="card-body p-5">

          <h2 class="text-center mb-4">
            Welcome Back
          </h2>

          <p class="text-center text-muted mb-4">
            Sign in to continue managing your orders.
          </p>

          <%= form_for(resource,
                       as: resource_name,
                       url: session_path(resource_name)) do |f| %>

            <div class="mb-3">

              <%= f.label :email, class: "form-label fw-bold" %>

              <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "form-control" %>

            </div>

            <div class="mb-3">

              <%= f.label :password, class: "form-label fw-bold" %>

              <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "form-control" %>

            </div>

            <% if devise_mapping.rememberable? %>

              <div class="form-check mb-4">

                <%= f.check_box :remember_me,
                    class: "form-check-input" %>

                <%= f.label :remember_me,
                    class: "form-check-label" %>

              </div>

            <% end %>

            <div class="d-grid">

              <%= f.submit "Log in",
                  class: "btn text-white w-100",
                  style: "background-color:#FF991C;" %>

            </div>

          <% end %>

          <hr>

          <div class="text-center mt-3">

            <%= render "devise/shared/links" %>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>