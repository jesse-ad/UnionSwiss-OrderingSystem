<div class="container mt-5">

  <div class="page-card">

<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="page-title">
      Products
    </h2>

    <p class="page-subtitle">
      Manage your product catalogue
    </p>

  </div>

  <%= link_to "+ Add New Product",
    new_product_path,
    class: "btn text-white",
    style: "background-color:#FF991C; border:none; border-radius:35px" %>

</div>

<table class="table table-hover align-middle">

  <thead>

    <tr>

      <th>Name</th>
      <th class="text-end">Actions</th>

    </tr>

  </thead>

  <tbody>

    <% @products.each do |product| %>

      <tr>

        <td>
          <strong>
            <%= product.name %>
          </strong>
        </td>

    <td class="text-end">

  <div class="d-flex justify-content-end align-items-center gap-2">

    <%= link_to edit_product_path(product),
        class: "icon-btn" do %>

      <%= image_tag "pen.png",
          size: "22x22",
          alt: "pen.png" %>

    <% end %>

    <%= button_to product_path(product),
        method: :delete,
        form: {
            class: "d-inline",
          data: {
            turbo_confirm: "Are you sure you want to delete this product?"
          }
        },
        class: "icon-btn delete-btn" do %>

      <%= image_tag "bin.png",
          size: "24x24",
          alt: "Delete" %>

    <% end %>

  </div>

</td>


      </tr>

    <% end %>

  </tbody>

</table>

  </div>

</div>
