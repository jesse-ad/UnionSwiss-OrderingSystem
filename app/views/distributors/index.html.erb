<div class="container mt-5">

  <div class="page-card">

<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="page-title">
      Distributors
    </h2>

    <p class="page-subtitle">
      Manage distributors and accounts
    </p>

  </div>

  <%= link_to "+ Add New Distributor",
      new_distributor_path,
      class: "btn text-white",
      style: "background-color:#FF991C; border:none; border-radius:35px" %>

</div>

<table class="table table-hover align-middle">

  <thead>

    <tr>

      <th>Name</th>
      <th>Currency</th>
      <th class="text-end">Actions</th>

    </tr>

  </thead>

  <tbody>

    <% @distributors.each do |distributor| %>

      <tr>

        <td>
          <strong>
            <%= distributor.name %>
          </strong>
        </td>

        <td>
          <%= distributor.currency %>
        </td>

    <td class="text-end">

  <div class="d-flex justify-content-end align-items-center gap-2">

    <%= link_to edit_distributor_path(distributor),
        class: "icon-btn" do %>

      <%= image_tag "pen.png",
          size: "22x22",
          alt: "pen.png" %>

    <% end %>

    <%= button_to distributor_path(distributor),
        method: :delete,
        form: {
            class: "d-inline",
          data: {
            turbo_confirm: "Are you sure you want to delete this distributor?"
          }
        },
        class: "icon-btn delete-btn" do %>

      <%= image_tag "bin.png",
          size: "24x24",
          alt: "Delete" %>

    <% end %>

  </div>

</td>


      </tr>

    <% end %>

  </tbody>

</table>

  </div>

</div>
