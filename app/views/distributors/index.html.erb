<div class="container mt-5">

  <div class="page-card">

<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="page-title">
      Distributors
    </h2>

    <p class="page-subtitle">
      Manage distributors and accounts
    </p>

  </div>

  <%= link_to "New Distributor",
      new_distributor_path,
      class: "btn primary-btn" %>

</div>

<table class="table table-hover align-middle">

  <thead>

    <tr>

      <th>Name</th>
      <th>Currency</th>
      <th class="text-end">Actions</th>

    </tr>

  </thead>

  <tbody>

    <% @distributors.each do |distributor| %>

      <tr>

        <td>
          <strong>
            <%= distributor.name %>
          </strong>
        </td>

        <td>
          <%= distributor.currency %>
        </td>

        <td class="text-end">

          <%= link_to "Edit",
              "/distributors/#{distributor.id}",
              class: "btn btn-sm btn-outline-secondary" %>

         <%= button_to "Delete",
            distributor_path(distributor),
            method: :delete,
            class: "btn btn-sm btn-outline-danger" %>

        </td>

      </tr>

    <% end %>

  </tbody>

</table>

  </div>

</div>
