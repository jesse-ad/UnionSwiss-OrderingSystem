<div class="container mt-5">

  <div class="row justify-content-center">

<div class="col-md-8">

  <div class="page-card">

    <h2 class="mb-4">
      Distributor Details
    </h2>

        <% if @distributor.errors.any? %>

        <div class="alert alert-danger">

            <ul class="mb-0">

            <% @distributor.errors.full_messages.each do |message| %>

                <li><%= message %></li>

            <% end %>

            </ul>

        </div>

    <% end %>

  <!-- New Distributor form -->
    <%= form_with model: @distributor do |form| %>

      <div class="mb-3">

        <%= form.label :name,
            class: "form-label" %>

        <%= form.text_field :name,
            class: "form-control" %>

      </div>

      <div class="mb-3">

        <%= form.label :currency,
            class: "form-label" %>

        <%= form.text_field :currency,
            class: "form-control" %>

      </div>

      <% if @distributor.new_record? %>

        <div class="mb-3">

          <%= label_tag :email,
              "Email",
              class: "form-label" %>

          <%= email_field_tag :email,
              nil,
              class: "form-control" %>

        </div>

        <div class="mb-4">

          <%= label_tag :password,
              "Password",
              class: "form-label" %>

          <%= password_field_tag :password,
              nil,
              class: "form-control" %>

        </div>

      <% end %>

      <%= form.submit "Save Distributor",
           class: "btn text-white",
           style: "background-color:#FF991C; border-color:#FF991C;"  %>

    <% end %>

  </div>

</div>

  </div>

</div>
