<h1>New Distributor</h1>

<%= form_with model: @distributor do |form| %>

    <div>
        <%= form.label :name %>
        <%= form.text_field :name %>
        <%= form.label :curreny %>
        <%= form.text_field :currency %>
    </div>

    <div>
        <%= form.submit "Create Distributor" %>
    </div>

<% end %>