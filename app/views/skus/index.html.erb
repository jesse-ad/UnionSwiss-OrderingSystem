<div class="container mt-5">

  <div class="page-card">

<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="page-title">
      SKUs
    </h2>

    <p class="page-subtitle">
      Manage distributor pricing
    </p>

  </div>

  <%= link_to "+ New SKU",
      new_sku_path,
      class: "btn primary-btn" %>

</div>

<table class="table table-hover align-middle">

  <thead>

    <tr>

      <th>Distributor</th>
      <th>Product</th>
      <th>Price Per Unit</th>
      <th class="text-end">Actions</th>

    </tr>

  </thead>

  <tbody>

    <% @skus.each do |sku| %>

      <tr>

        <td>
          <%= sku.distributor.name %>
        </td>

        <td>
          <%= sku.product.name %>
        </td>

        <td>
          <%= number_with_delimiter(sku.price_per_unit) %>
        </td>

      <td class="text-end">

  <div class="d-flex justify-content-end align-items-center gap-2">

    <%= link_to edit_sku_path(sku),
        class: "icon-btn" do %>

      <%= image_tag "pen.png",
          size: "22x22",
          alt: "pen.png" %>

    <% end %>

    <%= button_to sku_path(sku),
        method: :delete,
        form: {
            class: "d-inline",
          data: {
            turbo_confirm: "Are you sure you want to delete this SKU?"
          }
        },
        class: "icon-btn delete-btn" do %>

      <%= image_tag "bin.png",
          size: "24x24",
          alt: "Delete" %>

    <% end %>

  </div>

</td>

      </tr>

    <% end %>

  </tbody>

</table>

  </div>

</div>
