<h1>Edit SKU</h1>

<%= form_with model: @skus do |form| %>
    <div>
        <%= form.label :distributor_id %>
        <%= form.collection_select(:distributor_id, @distributor, :id, :name) %>
    </div>

    <div>
        <%= form.label :product_id %>
        <%= form.collection_select(:product_id, @product, :id, :name) %>
    </div>

    <div>
        <%= form.label :price_per_unit %>
        <%= form.number_field :price_per_unit %>
    </div>

    <div>
        <%= form.submit "Edit SKU" %>
    </div>

<% end %>